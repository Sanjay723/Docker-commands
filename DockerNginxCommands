docker run -itd alpine --- Starts a lightweight Alpine Linux container in the background.
docker exec -it nginxapp apk add --no-cache nginx --- Installs the Nginx web server inside the container using Alpine's package manager.
docker exec -it nginxapp ls var/www/localhost/htdocs/ --- Lists the files inside Alpine's default Nginx web root directory.
docker exec -it nginxapp mkdir var/www/html --- Creates a new custom web folder directory inside the container.
docker cp index.html nginxapp:/var/www/html/ --- Copies a local index.html file from your host machine into the container.
docker exec -it nginxapp ls var/www/html --- Lists the custom web folder contents to verify the file copy succeeded.
docker exec -it nginxapp ls etc/nginx/http.d/ --- Lists the contents of Nginx's configuration directory inside the container.
docker exec -it nginxapp cat etc/nginx/http.d/default.conf --- Displays the contents of Nginx's default server configuration file.
docker cp default.conf nginxapp:/etc/nginx/http.d/ --- Copies a custom default.conf file from your host to overwrite the container's Nginx configuration.
docker exec -it nginxapp cat etc/nginx/http.d/default.conf --- Displays the configuration file again to verify your changes were applied.
docker commit --change='CMD ["nginx", "-g", "daemon off;"]' nginxapp webapp:nginx --- Saves the modified container as a new image that automatically starts Nginx.
docker run -itd -p 8085:80 webapp:nginx --- Runs the new image as a container, mapping host port 8085 to container port 80.
docker tag webapp:nginx sanjaygovinds44/webappnginx:v1 --- Tags the local image with your Docker Hub username and version v1.
docker push sanjaygovinds44/webappnginx:v1 --- Uploads the tagged image to your public Docker Hub repository.
