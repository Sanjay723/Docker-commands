pwd - specifies present working directory
ls (ls -ltra . , ls -ltra ..) - list files in the system
cd dir_name - change current directory to specified directory
mkdir dir_name -- creates a directory in system
touch filename -- creates a file in 
. - specifies current directory
.. - specifies parent directory
mv ../*.tar . - move all files ending in .tar from parent directory directly into your current directory.
echo $? - non zero value exits immediately from bash script

entrypoint.sh
#!/usr/bin/env bash
set -e
NAME="$1"
echo "The name is $NAME"

configuration:
sudo nano /etc/netplan/50-cloud-init.yaml - network configuration file.
sudo netplan try
sudo netplan apply
getent passwd
getent group
getent group | grep "docker"
sudo usermod -aG docker ubuntu
newgrp docker

swarm configurations:
sudo hostnamectl set-hostname master1/worker-1/worker-2
exec bash
